{
    "name": "z3l/fasthtmlparser",
    "description": "Fast HTML / XML parser for scraping, with XPath 1.0 and CSS selectors. PHP port of z3l.FastHtmlParser.",
    "type": "library",
    "keywords": ["html", "parser", "xpath", "css", "selector", "scraping", "dom"],
    "homepage": "https://github.com/romanti3172/fasthtmlparser-php",
    "license": "LicenseRef-z3l-FastHtmlParser",
    "authors": [
        {
            "name": "z3l",
            "homepage": "https://github.com/romanti3172"
        }
    ],
    "support": {
        "issues": "https://github.com/romanti3172/fasthtmlparser-php/issues",
        "source": "https://github.com/romanti3172/fasthtmlparser-php"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-mbstring": "Unicode case folding of non-ASCII names and of XPath lower-case() / upper-case()"
    },
    "autoload": {
        "psr-4": {
            "Z3l\\FastHtmlParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Z3l\\FastHtmlParser\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "gen": "@php tools/gen.php ../z3l.FastHtmlParser/src/z3l.FastHtmlParser"
    },
    "config": {
        "sort-packages": true
    }
}
